{{#if blog}}

<div class="container py-5">
    <div class="row justify-content-center g-4">

        <!-- Nội dung bài viết -->
        <div class="col-lg-8">

            <article class="blog-detail-card">

                <!-- Ảnh bài viết -->
                <div class="blog-image-wrapper">
                    <img src="{{blog.image}}"
                         alt="{{blog.name}}"
                         class="blog-main-image">
                </div>

                <div class="blog-content-wrapper">

                    <!-- Tiêu đề -->
                    <div class="blog-header">
                        <h1 class="blog-title">
                            {{blog.name}}
                        </h1>

                        <div class="blog-meta">
                            <i class="bi bi-calendar3"></i>
                            <span>
                                Ngày đăng: {{dateFormat blog.createdAt "DD/MM/YYYY"}}
                            </span>
                        </div>
                    </div>

                    <hr class="blog-divider">

                    <!-- Nội dung bài viết -->
                    <div class="blog-detail-content">
                        {{{blog.currentContent}}}
                    </div>


                    <!-- =========================
                         PHÂN TRANG BÀI VIẾT
                         ========================= -->

                    {{#if blog.totalPages}}

                    <div class="blog-pagination">

                        <!-- QUAY LẠI -->
                        {{#if blog.previousPage}}
                            <a href="/blogs/{{blog.slug}}?page={{blog.previousPage}}"
                               class="pagination-btn">
                                ← Quay lại
                            </a>
                        {{/if}}


                        <!-- SỐ TRANG -->
                        <span class="pagination-info">
                            Trang {{blog.currentPage}} / {{blog.totalPages}}
                        </span>


                        <!-- ĐI TIẾP -->
                        {{#if blog.nextPage}}
                            <a href="/blogs/{{blog.slug}}?page={{blog.nextPage}}"
                               class="pagination-btn">
                                Đi tiếp →
                            </a>
                        {{/if}}

                    </div>

                    {{/if}}

                </div>

            </article>

        </div>


        <!-- Sidebar tác giả -->
        <div class="col-lg-4">

            <div class="author-card">

                <div class="author-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <h5 class="author-name">
                    Admin
                </h5>

                <p class="author-role">
                    Người quản trị website
                </p>

                <a href="/contact" class="author-contact-btn">
                    <i class="bi bi-envelope"></i>
                    Liên hệ
                </a>

            </div>

        </div>

    </div>
</div>


{{else}}

<div class="container py-5">
    <div class="not-found-card">

        <div class="not-found-icon">
            <i class="bi bi-file-earmark-x"></i>
        </div>

        <h2>Không tìm thấy bài viết</h2>

        <p>
            Bài viết bạn đang tìm kiếm không tồn tại hoặc đã được xóa.
        </p>

        <a href="/" class="not-found-btn">
            <i class="bi bi-house"></i>
            Về trang chủ
        </a>

    </div>
</div>

{{/if}}