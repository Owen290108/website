<div class="hero">

    <div class="container">

        <div class="left">

            <h1 class="h1">
                Chào, chúng tôi là <b>sì pai đờ &nbsp; men</b>.
                <br>
                Hành tình của những động màn
            </h1>

            <p class="h3">
                Hành tinh của nhưng S.v
                <abbr title="Accessibility">a11y</abbr>
                và những đòng bọn
            </p>

            <div>

                <a href="/contact" class="btn btn-primary">
                    Liên Hệ Về Tôi
                </a>

                <a href="/about" class="btn btn-secondary">
                    Về Tôi
                </a>

            </div>

        </div>


        <div class="right">

            <div class="pattern-bg"></div>

            <div class="img-box">

                <img
                    src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTsZyTTWBU8YZsSPs2E3tuCrWWilAIT2-Ylmqu7o728yg&s=10"
                    alt="Julia Walker"
                    class="hero-img"
                >

                <div class="shape shape-1"></div>

                <div class="shape shape-2"></div>

            </div>

        </div>

    </div>

</div>




<div class="main">

    <div class="container">


        <!-- =========================
             BLOG
        ========================== -->

        <div class="blog">

            <h2 class="h2">
                Latest Blog Post
            </h2>


            <div class="blog-card-group">


                {{#each blogs}}


                <!-- =========================
                     BLOG CARD
                ========================== -->

                <div class="blog-card">


                    <!-- ẢNH BÀI VIẾT -->

                    <div class="blog-card-banner">

                        <img
                            src="{{this.image}}"
                            alt="{{this.name}}"
                            width="250"
                            class="blog-banner-img"
                        >

                    </div>



                    <!-- NỘI DUNG -->

                    <div class="blog-content-wrapper">


                        <!-- CHỦ ĐỀ -->

                        <button class="blog-topic text-tiny">
                            Blog
                        </button>



                        <!-- TIÊU ĐỀ -->

                        <h3>

                            <a
                                href="/blogs/{{this.slug}}"
                                class="h3"
                            >

                                {{this.name}}

                            </a>

                        </h3>



                        <!-- MÔ TẢ -->

                        <p class="blog-text">

                            {{this.description}}

                        </p>



                        <!-- THÔNG TIN -->

                        <div class="wrapper-flex">


                            <div class="wrapper">


                                <a href="#" class="h4">
                                    Admin
                                </a>


                                <p class="text-sm">

                                    <time>

                                        {{this.createdAt}}

                                    </time>

                                </p>


                            </div>


                        </div>



                        <!-- =========================
                             SỬA / XÓA BÀI VIẾT
                        ========================== -->

                        <div class="blog-card-actions">


                            <!-- SỬA -->

                            <a
                                href="/blogs/{{this._id}}/edit"
                                class="blog-action-btn edit"
                            >

                                <ion-icon
                                    name="create-outline"
                                ></ion-icon>

                                <span>
                                    Sửa
                                </span>

                            </a>



                            <!-- XÓA -->

                            <form
                                method="POST"
                                action="/blogs/{{this._id}}?_method=DELETE"
                                onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này không?');"
                            >

                                <button
                                    type="submit"
                                    class="blog-action-btn delete"
                                >

                                    <ion-icon
                                        name="trash-outline"
                                    ></ion-icon>

                                    <span>
                                        Xóa
                                    </span>

                                </button>

                            </form>


                        </div>


                    </div>


                </div>


                {{/each}}


            </div>



            <!-- =========================
                 PHÂN TRANG
                 3 BÀI / TRANG
            ========================== -->

            {{#if totalPages}}

            <div class="blog-pagination">


                <!-- =========================
                     QUAY LẠI
                ========================== -->

                {{#if previousPage}}

                    <a
                        href="/?page={{previousPage}}"
                        class="pagination-btn"
                    >

                        ← Quay lại

                    </a>

                {{/if}}



                <!-- =========================
                     SỐ TRANG
                ========================== -->

                <span class="pagination-info">

                    Trang {{currentPage}} / {{totalPages}}

                </span>



                <!-- =========================
                     ĐI TIẾP
                ========================== -->

                {{#if nextPage}}

                    <a
                        href="/?page={{nextPage}}"
                        class="pagination-btn"
                    >

                        Đi tiếp →

                    </a>

                {{/if}}


            </div>

            {{/if}}


        </div>




        <!-- =========================
             SIDEBAR
        ========================== -->

        <div class="aside">


            <!-- =========================
                 TOPICS
            ========================== -->

            <div class="topics">

                <h2 class="h2">
                    Topics
                </h2>


                <a href="#" class="topic-btn">

                    <div class="icon-box">

                        <ion-icon
                            name="server-outline"
                        ></ion-icon>

                    </div>

                    <p>
                        Database
                    </p>

                </a>



                <a href="#" class="topic-btn">

                    <div class="icon-box">

                        <ion-icon
                            name="accessibility-outline"
                        ></ion-icon>

                    </div>

                    <p>
                        Accessibility
                    </p>

                </a>



                <a href="#" class="topic-btn">

                    <div class="icon-box">

                        <ion-icon
                            name="rocket-outline"
                        ></ion-icon>

                    </div>

                    <p>
                        Web Performance
                    </p>

                </a>


            </div>




            <!-- =========================
                 TAGS
            ========================== -->

            <div class="tags">

                <h2 class="h2">
                    Tags
                </h2>


                <div class="wrapper">


                    <button class="hashtag">
                        #mongodb
                    </button>


                    <button class="hashtag">
                        #nodejs
                    </button>


                    <button class="hashtag">
                        #a11y
                    </button>


                    <button class="hashtag">
                        #webperf
                    </button>


                </div>

            </div>




            <!-- =========================
                 CONTACT
            ========================== -->

            <div class="contact">

                <h2 class="h2">
                    Let's Talk
                </h2>


                <div class="wrapper">

                    <p>
                        Do you want to learn more about how I can help your company overcome problems?
                    </p>

                </div>

            </div>




            <!-- =========================
                 NEWSLETTER
            ========================== -->

            <div class="newsletter">

                <h2 class="h2">
                    Newsletter
                </h2>


                <div class="wrapper">

                    <p>
                        Subscribe to our newsletter.
                    </p>


                    <form action="#">

                        <input
                            type="email"
                            name="email"
                            placeholder="Email Address"
                            required
                        >


                        <button
                            type="submit"
                            class="btn btn-primary"
                        >

                            Subscribe

                        </button>

                    </form>


                </div>

            </div>


        </div>


    </div>

</div>

